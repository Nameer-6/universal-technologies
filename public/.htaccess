# Hostinger / Apache rules for the prerendered site in dist/.
# Every sitemap route is a real file at <route>/index.html, so no SPA fallback is
# needed. These rules mirror scripts/serve.mjs (see docs/seo-delivery.md).

Options -MultiViews -Indexes

# Serve /about from about/index.html without first redirecting to /about/ —
# the canonical URLs have no trailing slash.
DirectorySlash Off
DirectoryIndex index.html

# Unknown paths get the real 404 page with a 404 status.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: www -> apex. (Hostinger already forces HTTPS; HSTS below
  # makes browsers skip the http hop entirely.)
  RewriteCond %{HTTP_HOST} ^www\.universal-technologies\.com$ [NC]
  RewriteRule ^ https://universal-technologies.com%{REQUEST_URI} [L,R=301,NE]

  # Retired service URLs.
  RewriteRule ^services/ai/?$ /services/ai-agents [L,R=301]
  RewriteRule ^services/(software-development|ui-ux)/?$ /services/end-to-end-development [L,R=301]
  RewriteRule ^services/cybersecurity/?$ - [G,L]

  # /path/index.html and /path/ -> /path (only for what the client asked for,
  # so the internal rewrite below cannot loop).
  RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^ /%1 [L,R=301,NE]

  # Real files (assets, images, robots.txt, llms.txt …) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Clean route -> its prerendered page.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # Everything else falls through to ErrorDocument 404.
</IfModule>

<IfModule mod_headers.c>
  # Security headers (HSTS, clickjacking, MIME sniffing, referrer leakage).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTML: cacheable but always revalidated (ETag/304), so a deploy shows up at
  # once and pages never point at deleted hashed assets. (Was: never cache at all.)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Un-hashed public files (logos, og-image, favicons, robots/llms/sitemap)
  # can change between deploys, so keep their cache short.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|webmanifest|txt|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # JS/CSS/fonts only exist in /assets/ with a content hash in the filename,
  # so they are safe to cache forever.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>
